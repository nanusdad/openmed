# Local-only OpenMed NER and de-identification demo.
# Copy to demo/.env and fill every name. The API refuses to start if any
# name is missing. Do not put secrets in this file.
#
# Bind addresses must be loopback. CORS is the browser origin only.
# After the first model download the API prefers Hub offline mode. You can
# also set the offline flags to 1 before a later launch.

OPENMED_DEMO_API_HOST=127.0.0.1
OPENMED_DEMO_API_PORT=8765
OPENMED_DEMO_WEB_HOST=127.0.0.1
OPENMED_DEMO_WEB_PORT=5173
OPENMED_DEMO_CORS_ORIGIN=http://127.0.0.1:5173
VITE_OPENMED_DEMO_API_ORIGIN=http://127.0.0.1:8765

# Registry keys. Apple Silicon with the mlx extra resolves an MLX sibling
# when one exists and OPENMED_DEMO_BACKEND=auto.
OPENMED_DEMO_NER_MODEL=disease_detection_electramed_33m
OPENMED_DEMO_PII_MODEL=pii_superclinical_small

# Model weights. Pull and inference use OPENMED_DEMO_CACHE_DIR.
# Point HF_HUB_CACHE at the same directory so Hub tooling sees those files.
OPENMED_DEMO_CACHE_DIR=.cache/openmed-demo/hub
HF_HOME=.cache/openmed-demo
HF_HUB_CACHE=.cache/openmed-demo/hub

HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0
OPENMED_OFFLINE=0

# auto prefers MLX on Apple Silicon when the mlx extra is installed,
# otherwise local Hugging Face weights. hf and mlx are explicit.
# remote is rejected.
OPENMED_DEMO_BACKEND=auto
